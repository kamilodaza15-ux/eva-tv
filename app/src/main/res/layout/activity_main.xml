<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0E0614">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Menu izquierdo -->
        <LinearLayout
            android:id="@+id/menuPane"
            android:layout_width="170dp"
            android:layout_height="match_parent"
            android:background="#FF1A0B26"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/brand"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="#FFFFFFFF"
                android:contentDescription="@string/app_name"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_header" />

            <ListView
                android:id="@+id/menu"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:choiceMode="singleChoice"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:drawSelectorOnTop="true"
                android:listSelector="@drawable/selector_menu"
                android:paddingTop="8dp" />
        </LinearLayout>

        <!-- Centro: ventana de video -->
        <LinearLayout
            android:id="@+id/centerPane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <FrameLayout
                android:id="@+id/previewBox"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#FF000000"
                android:focusable="false">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/player"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:focusable="false"
                    app:resize_mode="fit"
                    app:use_controller="false" />

                <ProgressBar
                    android:id="@+id/spinner"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/nowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/loading"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nowHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="OK en un canal: verlo aquí   ·   Derecha u OK otra vez: pantalla completa   ·   Menú del control: favorito"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Derecha: lista de canales -->
        <LinearLayout
            android:id="@+id/listPane"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:background="#FF1A0B26"
            android:orientation="vertical">

            <TextView
                android:id="@+id/listTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:padding="16dp"
                android:textColor="#FFA8DE78"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="8dp"
                android:background="#33FFFFFF"
                android:hint="Buscar…"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:inputType="text"
                android:maxLines="1"
                android:nextFocusDown="@+id/list"
                android:padding="12dp"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#99FFFFFF"
                android:textSize="18sp"
                android:visibility="gone" />

            <ListView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:drawSelectorOnTop="false"
                android:listSelector="@drawable/selector_item" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/osd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="32dp"
        android:background="#B3000000"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:text="@string/loading"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:visibility="gone" />
</FrameLayout>
